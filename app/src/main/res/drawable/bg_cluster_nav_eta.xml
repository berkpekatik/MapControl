<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ana zemin -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cluster_nav_eta_fill" />
            <corners android:radius="@dimen/cluster_nav_card_radius" />
        </shape>
    </item>
    <!-- Üstten alta yumuşak ışık yansıması (manevra kartıyla aynı dil) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/cluster_nav_card_highlight"
                android:type="linear" />
            <corners android:radius="@dimen/cluster_nav_card_radius" />
        </shape>
    </item>
    <!-- İnce kenar çizgisi -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/cluster_nav_card_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/cluster_nav_eta_stroke" />
        </shape>
    </item>
</layer-list>
