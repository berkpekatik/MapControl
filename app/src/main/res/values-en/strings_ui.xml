    <string name="projection_google_maps_nav_title">Navigation notification (Google / Petal)</string>
    <string name="projection_google_maps_nav_desc">When Google Maps or Petal Maps starts guidance, open cluster projection automatically. Requires notification access and the selected map as the projection target. Stopping guidance does not close projection.</string>
    <string name="projection_google_maps_nav_on_help">Open cluster when a navigation notification arrives.</string>
    <string name="projection_google_maps_nav_off_help">Do not open cluster from navigation notifications.</string>
    <string name="projection_google_maps_nav_need_access">Enable notification access for MapControl first.</string>
    <string name="projection_map_swipe_title">Map swipe</string>
    <string name="projection_map_swipe_desc">Off unless you turn it on. Two fingers left: if the cluster is closed, Google Maps or Yandex Maps on the main screen opens on the cluster. Google Maps uses the existing cluster map. If the cluster is already showing one of those maps and the other is on the main screen, they swap. Two fingers right closes cluster projection. Other apps are ignored, so the car screen is not taken over. Usage access is required.</string>
    <string name="projection_map_swipe_on_help">Handle two-finger swipes for Google Maps and Yandex Maps only.</string>
    <string name="projection_map_swipe_off_help">Ignore car swipes. MapControl does not move any app.</string>
    <string name="projection_map_swipe_need_access">Enable usage access for MapControl first. The swipe stays off until then.</string>
    <string name="projection_google_maps_nav_summary_idle">No active Google Maps guidance notification.</string>
    <string name="projection_google_maps_cluster_cards_title">Google Maps → Cluster cards</string>
    <string name="projection_google_maps_cluster_cards_desc">Shows distance, maneuver, and ETA from the navigation notification as cards on the cluster display. Requires notification access.</string>
