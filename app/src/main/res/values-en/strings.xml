    <string name="app_name">Map Control</string>
    <string name="launch_splash_loading">Loading…</string>
    <string name="accessibility_service_description">Floating Back (global BACK), typing into the focused field from web management, and reading Yandex Maps navigation cards for the cluster display. After changing settings, turn the service off and on again.</string>
    <string name="yandex_cluster_nav_section_title">Yandex → Cluster</string>
    <string name="yandex_cluster_nav_section_desc">Reads Yandex Maps guidance (maneuver, ETA) via accessibility and shows it on the cluster display. Does not cover the home screen left quadrant. Accessibility service must be enabled.</string>
    <string name="yandex_cluster_nav_help_on">Show maneuver and ETA cards on the cluster during guidance.</string>
    <string name="yandex_cluster_nav_help_off">Turn off cluster navigation summary.</string>
