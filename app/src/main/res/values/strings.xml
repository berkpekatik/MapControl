    <string name="wifi_on_screen_on_toggle_yes_help">Araç uyku modu ya da ekran kapanıp açtığında otomatik olarak Wi‑Fi tazelenir. </string>
    <string name="wifi_on_screen_on_toggle_no_help">Yalnızca açılışta ve elle «Wi‑Fi tazele» ile çalışsın.</string>

