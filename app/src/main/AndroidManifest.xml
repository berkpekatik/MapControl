<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    
    <!-- VDBus Service Permission (from SMS service and other VDBus apps) -->
    <uses-permission android:name="ivi.vds.permission.SERVICE" />
    
    <!-- System level permissions (may be required for VDBus) -->
    <uses-permission android:name="android.permission.READ_SECURE_SETTINGS" 
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" 
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    
    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_LOGS"/>
    <!-- Bölünmüş ekran: önceden açık başka uygulama görevini sınırlarıyla öne almak (moveTaskToFront, normal izin). -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    
    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    
    <!-- Audio recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- Camera permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Kamera izni donanımı zorunlu kılmasın (lint PermissionImpliesUnsupportedChromeOsHardware). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    
    <!-- Bluetooth -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL"
        tools:ignore="ProtectedPermissions" />
    
    <!-- Storage (for MANAGE_EXTERNAL_STORAGE appops) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" 
        tools:ignore="ScopedStorage" />
    
    <!-- VPN (for ACTIVATE_VPN appops) -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    
    <!-- System Alert Window (for SYSTEM_ALERT_WINDOW appops) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Spor hız kadranı: android.car PERF_VEHICLE_SPEED 10 Hz (tehlikeli izin; uygulama durağanken bir kez sorar ya da
         adb shell pm grant <paket> android.car.permission.CAR_SPEED). Yoksa ReadOnly 119 gösterge hızı kullanılır. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    
    <!-- Query all packages permission (Android 11+) - Required to see all installed apps -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" 
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" 
        tools:ignore="ProtectedPermissions" />
    
    <!-- Wi-Fi permissions (wifi.apk'den alındı) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.BROADCAST_STICKY" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Telefon (launcher): rehber, arama geçmişi ve arama başlatma. Araçta sistem izin penceresi yoksa
         adb shell pm grant com.mapcontrol android.permission.READ_CONTACTS (READ_CALL_LOG, CALL_PHONE) ile verilir. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Telefon: Telecom ile cevap/kapat (yansımasız yedek; araçta adb pm grant ile verilir). -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_UPDATES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_INTERNAL_STORAGE" />
    
    <!-- Package uninstall permissions -->
    <!-- REQUEST_DELETE_PACKAGES: Diğer uygulamaların kaldırılmasını talep etmek için (ACTION_DELETE) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" 
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" 
        tools:ignore="ProtectedPermissions" />
    <!-- http(s) linkleri açan tarayıcı / harita uygulamalarını görmek (Android 11+ paket görünürlüğü) -->
    <queries>
        <package android:name="com.desaysv.materialvehicle" />
        <package android:name="com.desaysv.materialvehicle.t19c" />
        <package android:name="com.desaysv.materialvehicle.t19c.ev" />
        <package android:name="com.desaysv.materialvehicle.t18fl3" />
        <package android:name="com.desaysv.materialvehicle.t26" />
        <package android:name="com.desaysv.materialvehicle.m1e" />
        <package android:name="com.desaysv.materialvehicle.m1e.phev" />
        <package android:name="com.desaysv.materialvehiclet19fl" />
        <package android:name="com.desaysv.materialvehiclet1efl" />
        <package android:name="com.desaysv.engmode" />
        <package android:name="ru.yandex.yandexmaps" />
        <package android:name="ru.yandex.yandexnavi" />
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>
    
    <application
        android:name=".MapControlApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MapControl"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <!-- android.car isteğe bağlı kitaplık (CarPropertyManager hız okuması); araçta yoksa uygulama yine kurulur. -->
        <uses-library android:name="android.car" android:required="false" />

        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="MapControl"
            android:theme="@style/Theme.MapControl.Splash"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Araç Launcher Modu: varsayılan olarak KAPALI (enabled=false). Ayarlar > Araç Launcher
             Modu açıldığında LauncherModeManager bu bileşeni etkinleştirir; böylece MapControl,
             cihazın Ana Ekran (HOME) uygulaması olarak seçilebilir hale gelir. Hedef: yeni launcher
             (HomeLauncherActivity). Alias adı, mevcut kullanıcı tercihleri bozulmasın diye korunur. -->
        <activity-alias
            android:name=".ui.activity.MainActivityHomeAlias"
            android:targetActivity=".launcher.HomeLauncherActivity"
            android:enabled="false"
            android:exported="true"
            android:label="MapControl (Ana Ekran)"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        
        <activity
            android:name=".ui.activity.DmsFaceProfileActivity"
            android:label="@string/dms_face_title"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.activity.CameraActivity"
            android:label="Kamera Test"
            android:screenOrientation="landscape" />
        
        <activity
            android:name=".ui.activity.ClusterVDBusTestActivity"
            android:label="Cluster / VDBus bench"
            android:screenOrientation="landscape" />

        <!-- Ekranı karart: tam siyah, en düşük parlaklık; dokununca kapanır (launcher kutucuğu açar). -->
        <activity
            android:name=".launcher.ScreenOffActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Yeni launcher (Kotlin). HOME rolü yalnızca MainActivityHomeAlias üzerinden (Launcher Modu anahtarı); uygulama listesinde ayrı simgesi yoktur. -->
        <activity
            android:name=".launcher.HomeLauncherActivity"
            android:exported="true"
            android:label="Ana Ekran"
            android:launchMode="singleTask"
            android:taskAffinity="com.mapcontrol.home"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        </activity>

        <!-- Mini gösterge: bölünmüş ekranın bir yarısında (960 x ~610) açılan, boyutu değişebilen ayrı ekran (ana ekran
             bölünemez). Uygulama listesi simgesi aşağıdaki alias'ta (yalnız launcher modunda); serbest pencere (freeform) bölmesinde seçilebilir. Kendi görev
             ilişkisi (taskAffinity) ana ekranla ve FrostNav'la aynı göreve karışmasın diye. -->
        <activity
            android:name="com.mapcontrol.launcher.MiniDashActivity"
            android:exported="true"
            android:label="Mini gösterge"
            android:launchMode="singleTask"
            android:taskAffinity="com.mapcontrol.minidash"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Sahne.DriveHalf" />

        <!-- Mini göstergenin uygulama listesi simgesi: varsayılan KAPALI; yalnız FrostNav launcher modu açıkken
             LauncherModeManager etkinleştirir (MiniDashEntry). Bölünmüş ekran etkinliği bileşen adıyla açar, simgeye bağlı değil. -->
        <activity-alias
            android:name="com.mapcontrol.launcher.MiniDashLauncherAlias"
            android:targetActivity="com.mapcontrol.launcher.MiniDashActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Mini gösterge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Sürüş ekranının harita yarısı, harita uygulaması yokken ("+ Harita ekle"; DriveScreen). Yalnız bölünmüş ekran başlatıcısı
             açar; kendi görev ilişkisi, uygulama listesinde simgesi yok. -->
        <activity
            android:name="com.mapcontrol.ui.activity.DriveMapPickerActivity"
            android:exported="false"
            android:label="Harita ekle"
            android:launchMode="singleTask"
            android:taskAffinity="com.mapcontrol.drivemap"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Sahne.DriveHalf" />

        <!-- FileProvider for APK installation -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
        
        <!-- Foreground Service - Arka planda çalışması için -->
        <receiver
            android:name=".admin.MapControlDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_mapcontrol" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Uygulama güncellenince Launcher Modu'nu (HOME alias + cihaz sahibi sabitlemesi) geri kurar. -->
        <receiver
            android:name=".service.PackageReplacedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- adb kurulumundan once kamerayi kapatir. DUMP: yalnizca adb shell gonderebilir. -->
        <receiver
            android:name=".dvr.InstallPrepareReceiver"
            android:permission="android.permission.DUMP"
            android:exported="true" />

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.RecordingService"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".service.MapControlService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        
        <!-- Global Back Service - AccessibilityService -->
        <service
            android:name=".service.GlobalBackService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".media.LauncherMediaNotificationListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        
    </application>

</manifest>

